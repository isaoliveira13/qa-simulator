# Base da API do Zenta (opcional — cai no padrão https://api.zenta.to se não definir)
ZENTA_BASE_URL=https://api.zenta.to

# Fallback para resolver host_token automaticamente a partir do host_slug
# (deixe vazio se a interface sempre vai enviar o host_token direto)
ZENTA_DOMAIN_TOKEN=

# Chave da OpenAI, usada para a decisão do "simulador" a cada turno
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Geradas automaticamente ao conectar um banco Vercel KV ao projeto
# (Vercel > seu projeto > Storage > Create Database > KV)
# Usadas tanto pelas sessões de teste quanto pelo login e pelas personas por usuário.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Opcional: restringe o cadastro a um domínio de email (ex.: zenta.to).
# Deixe vazio para permitir qualquer email. Recomendado definir em produção
# para que só pessoas da empresa possam criar conta.
ALLOWED_EMAIL_DOMAIN=

# Redefinição de senha por email (Resend). Sem RESEND_API_KEY, o "esqueci a
# senha" responde normalmente mas não envia email.
#   RESEND_API_KEY  -> chave em https://resend.com (plano free cobre time interno)
#   EMAIL_FROM      -> remetente; use "onboarding@resend.dev" para testar antes
#                      de verificar um domínio, depois troque por no-reply@zenta.to
#   APP_BASE_URL    -> URL pública deste ambiente, usada no link do email
#                      (ex.: https://coisasdaisa-git-stage-....vercel.app).
#                      Se vazio, usa o host da requisição.
RESEND_API_KEY=
EMAIL_FROM=ISA QA <onboarding@resend.dev>
APP_BASE_URL=
